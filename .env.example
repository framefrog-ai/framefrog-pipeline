# FrameFrog configuration — safe example values.
# Copy to `.env` and adjust. Never commit real credentials.
#
# Every value below is the name of an environment variable read by
# `app.core.config.Settings`.

# --- service ---------------------------------------------------------------
APP_ENV=development
LOG_LEVEL=INFO
# Required when APP_ENV=production. Leave empty only in development.
API_KEY=
# HMAC key for signed artefact download links. Leave empty to issue no links.
SIGNING_SECRET=
SIGNING_TTL_SECONDS=3600

# --- storage / persistence --------------------------------------------------
WORK_DIR=./work
DATABASE_URL=sqlite:///./work/framefrog.db
STORAGE_BACKEND=local

# --- media limits -----------------------------------------------------------
MAX_UPLOAD_BYTES=2147483648
MAX_VIDEO_DURATION_SECONDS=3600
MAX_VIDEO_WIDTH=3840
MAX_VIDEO_HEIGHT=2160
MAX_OUTPUT_FPS=60
MAX_CONCURRENT_JOBS=2

# --- binaries ---------------------------------------------------------------
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe

# --- object storage (S3 / R2 / MinIO) --------------------------------------
# Only used when STORAGE_BACKEND=s3.
S3_ENDPOINT_URL=
S3_REGION=us-east-1
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_INPUT_PREFIX=inputs
S3_INTERMEDIATE_PREFIX=intermediate
S3_OUTPUT_PREFIX=outputs
PRESIGNED_URL_EXPIRY_SECONDS=900

# --- models -----------------------------------------------------------------
MODEL_CACHE_DIR=./models
DEEPFILTERNET_ENABLED=true
RIFE_ENABLED=true
RIFE_REPOSITORY_PATH=
RIFE_MODEL_PATH=

# --- compute ----------------------------------------------------------------
# auto | cpu | cuda
COMPUTE_DEVICE=auto
# When true, stages that need a GPU fail with a capability error instead of
# silently falling back to the CPU.
GPU_VALIDATION_REQUIRED=false
